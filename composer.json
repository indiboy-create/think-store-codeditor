{
    "name": "youvision/think-store-codeditor",
    "description": "ThinkPHP 8 模板代码编辑器扩展：基于 Ace 与 layui 编辑 HTML + PHP 混合模板，提供页面、读取、更新、新增与静态资源路由。",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "thinkphp8",
        "codeditor",
        "ace",
        "template",
        "editor",
        "store"
    ],
    "authors": [
        {
            "name": "indiboy-create",
            "homepage": "https://github.com/indiboy-create"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0",
        "topthink/think-view": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkStoreCodeditor\\": "src/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkStoreCodeditor\\Service"
            ],
            "config": {
                "store_codeditor": "config/store_codeditor.php"
            }
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "@php tests/verify.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}